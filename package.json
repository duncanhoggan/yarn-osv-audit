{
  "name": "yarn-osv-audit",
  "version": "0.1.6",
  "description": "Audit Yarn v1 lockfiles against the OSV vulnerability database",
  "bin": {
    "yarn-osv-audit": "dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format esm",
    "test": "vitest",
    "prepublishOnly": "npm run build"
